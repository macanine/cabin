{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app"
    ],
    "resources": {
      "../core/target/aarch64-unknown-linux-musl/release/cabind": "cabind",
      "../vm/config/": "vm/config/",
      "../vm/assets/": "vm/assets/",
      "../build/vendor/macos-arm64/": "vendor/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Cabin",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 18, "y": 20 },
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ]
  }
}
