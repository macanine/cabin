{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cabin",
  "version": "0.2.0",
  "identifier": "dev.cabin.desktop",
  "build": {
    "beforeDevCommand": "npm run vendor && npm run build:agentd && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vendor && npm run build:agentd && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cabin",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Workspaces and sessions for local coding agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "policykit-1"
        ]
      }
    }
  }
}
